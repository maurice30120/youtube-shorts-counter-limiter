{
  "manifest_version": 3,
  "name": "YouTube Shorts Counter",
  "version": "1.3.8",
  "description": "Compte le nombre de YouTube Shorts visités",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Shorts Counter",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  }
}
